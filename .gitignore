.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Model weights: fetched via scripts/download_models.sh and download_owlv2.sh.
# The 31M gaze model is 128 MB and OWLv2 is 163 MB, both above GitHub's limit.
models/*.onnx
models/owlv2/

# Auto-generated target configs
config/auto_*.json

# Custom detector training: datasets, runs and checkpoints are all local
data/
runs/
*.pt
*.onnx


# Verification images: fetched via scripts/fetch_testdata.py so that no
# third-party image files are vendored here.
testdata/*.jpg
testdata/*.png
testdata/*.mp4

# Generated output
out/
*.csv

# Third-party reference implementation, kept locally for I/O contract checking.
reference/

# Site-specific target layout (yours will differ; example is committed)
config/targets.json
notebooks/.ipynb_checkpoints/
